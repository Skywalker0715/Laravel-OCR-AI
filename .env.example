APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# SELALU false di production — debug page bisa membocorkan stack trace &
# isi .env. Set true hanya saat debugging lokal.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=your_port
DB_DATABASE=your_database_name
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mode queue (bagaimana AIParserJob diproses):
#  - database (default): job diproses async lewat tabel `jobs`. WAJIB
#    menjalankan worker terpisah: `php artisan queue:work` (lihat README).
#  - sync: job diproses LANGSUNG saat request (tanpa worker terpisah).
#    Trade-off: request upload sedikit lebih lama menunggu OCR+AI selesai.
#    Cocok untuk pemakaian personal/single-user tanpa worker.
#  - redis / beanstalkd: bila memakai server queue.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

Cohere AI (parsing OCR → data terstruktur). Model command-light sudah tidak
# tersedia di Cohere (hapus Sep 2025); pakai command-r7b-12-2024 (default, lebih
# ringan/cepat) atau model lain yang didukung. Lihat
# https://docs.cohere.com/docs/models
COHERE_API_KEY=
COHERE_MODEL=command-r7b-12-2024
