APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# SELALU false di production — debug page bisa membocorkan stack trace &
# isi .env. Set true hanya saat debugging lokal.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Level log minimal yang DITULIS ke storage/logs.
# - info (default, recommended untuk production): hanya event operasional —
#   job parsing mulai/selesai, Cohere gagal, guard total, exception. Isi struk,
#   respons AI mentah, dan pertanyaan user TIDAK ikut tertulis (kode memakai
#   Log::debug + cuplikan 200 karakter, lihat App\Support\LogSanitizer).
# - debug: aktifkan HANYA saat menelusuri masalah parsing di server sendiri.
#   Jangan dipakai di production: teks struk memuat nama toko, alamat, nomor
#   telepon, dan nominal transaksi milik pengguna.
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=your_port
DB_DATABASE=your_database_name
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Isi session (login state) dienkripsi sehingga token sesi tidak bisa dibaca
#sekalipun cookie sempat bocor (mis. lewat log proxy atau backup).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# -*- CHECKLIST PRODUCTION (ringkas, hanya yang berubah dari default) -*-
# Selain semua nilai di bawah, pastikan juga:
#   1. APP_DEBUG=false (tetap seperti bawaan file ini) — halaman debug
#      menampilkan stack trace & isi .env ke siapa pun.
#   2. APP_ENV=production  (berganti dari "local" di baris atas).
#   3. LOG_LEVEL=info — JANGAN debug di production, isi struk/pertanyaan user
#      akan ikut tertulis ke storage/logs/laravel.log.
#   4. COHERE_API_KEY diisi dengan key milik Anda sendiri (lihat bagian
#      "Cara Mendapatkan Cohere API Key"); file ini sengaja kosong.
#   5. Queue worker dijalankan dengan --timeout=150 (lihat "Aturan Timeout Queue").
#
# SESSION_SECURE_COOKIE — HANYA jika situs diakses lewat HTTPS (atau di
# belakang reverse proxy yang mengakhiri TLS). Cookie session lalu hanya
# dikirim melalui koneksi terenkripsi. JANGAN menyalakannya kalau aplikasi
# masih diakses lewat http:// (login tidak akan pernah berhasil disimpan).
#SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mode queue (bagaimana AIParserJob diproses):
#  - database (default): job diproses async lewat tabel `jobs`. WAJIB
#    menjalankan worker terpisah dengan timeout yang benar:
#    `php artisan queue:work --timeout=150` (lihat README).
#  - sync: job diproses LANGSUNG saat request (tanpa worker terpisah).
#    Trade-off: request upload sedikit lebih lama menunggu OCR+AI selesai.
#    Cocok untuk pemakaian personal/single-user tanpa worker.
#  - redis / beanstalkd: bila memakai server queue.
QUEUE_CONNECTION=database

# Berapa detik Laravel menunggu sebelum menganggap job hilang & mengambilnya
# ulang. WAJIB lebih besar dari $timeout job (App\Jobs\AIParserJob::$timeout
# = 150 detik). Kalau lebih kecil, job yang masih diproses worker pertama akan
# diambil worker kedua dan dieksekusi DUA KALI (parsing ganda, notifikasi
# kembar). Jangan turunkan angka ini tanpa mengecek timeout job.
# Nilai 180 memberi jarak 30 detik di atas timeout job.
# Aturan lengkap: $timeout job <= --timeout worker (150) < retry_after (180).
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cohere AI (parsing OCR → data terstruktur). Bawaan command-a-03-2025
# (akurasi paling baik, tapi paling mahal per token). Ingin lebih hemat? isi
# COHERE_MODEL=command-r7b-12-2024. Lihat https://docs.cohere.com/docs/models
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# Opsional: model khusus untuk fitur "Tanya AI" (FinancialInsightService).
# Kosong = pakai COHERE_MODEL.
COHERE_INSIGHT_MODEL=
# Batas pertanyaan fitur "Tanya AI" per user per hari (default 10).
AI_INSIGHT_DAILY_LIMIT=10
# Batas anti-spam "Tanya AI" per user per menit (default 30). Nilainya harus
# lebih besar dari batas harian; tugasnya menahan spam/bot, bukan mengatur
# jatah harian.
AI_INSIGHT_BURST_LIMIT=30
